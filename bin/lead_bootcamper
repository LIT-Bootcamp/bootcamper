#!/bin/sh
set -eu

case "${1:-}" in
  push) shift; BOOTCAMPER_PUSH_AGENT=lead_bootcamper git push "$@" ;;
  commit) shift; BOOTCAMPER_RELEASE_AGENT=lead_bootcamper git commit "$@" ;;
  pr) shift; gh pr create "$@" ;;
  merge) shift; gh pr merge "$@" ;;
  *) echo "Usage: bin/lead_bootcamper {push|commit|pr|merge} [args...]" >&2; exit 64 ;;
esac
