<% content_for :title, t("confirmation.success_title") %>

<section class="mx-auto max-w-xl px-4" aria-labelledby="confirmation-success-title">
  <div class="rounded-panel border border-teal/40 bg-surface-raised p-6 shadow-lifted md:p-8" role="status">
    <h1 id="confirmation-success-title" class="font-display text-3xl font-bold text-ink"><%= t("confirmation.success_title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("confirmation.success_message") %></p>
  </div>
</section>
