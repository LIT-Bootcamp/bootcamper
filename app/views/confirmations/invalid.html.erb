<% content_for :title, t("confirmation.invalid_title") %>

<section class="mx-auto max-w-xl px-4" aria-labelledby="confirmation-invalid-title">
  <div class="rounded-panel border border-danger/50 bg-surface-raised p-6 shadow-lifted md:p-8" role="alert">
    <h1 id="confirmation-invalid-title" class="font-display text-3xl font-bold text-ink"><%= t("confirmation.invalid_title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("confirmation.invalid_message") %></p>
  </div>
</section>
