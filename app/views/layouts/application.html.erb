<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("home.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      (() => {
        let mode = null
        try { mode = window.localStorage.getItem("bootcamper-theme") } catch (_error) { /* use system */ }
        const dark = mode !== "light" && (mode === "dark" || mode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches || mode === null)
        document.documentElement.dataset.theme = dark ? "dark" : "light"
      })()
    </script>
  </head>
  <body class="min-h-screen bg-surface text-ink" data-controller="theme">
    <a class="sr-only z-50 rounded-control bg-surface-raised px-control py-control text-ink focus:not-sr-only focus:fixed focus:left-control focus:top-control" href="#main-content">
      <%= t("navigation.skip_to_content") %>
    </a>

    <div class="min-h-screen">
      <%= render "layouts/navigation" %>

      <main id="main-content" class="min-w-0 pb-24 pt-8 md:pt-10">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
