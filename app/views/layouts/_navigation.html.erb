<% signed_in = respond_to?(:user_signed_in?) && user_signed_in? %>
<% navigation_items = [["home", "/"], ["workshops", "/design/workshop-map"], ["tasks", "/tasks"], ["team", "/team"], ["calendar", "/calendar"]] %>

<header class="cyber-panel sticky top-0 z-30 border-x-0 border-t-0 bg-surface-raised/95 shadow-card backdrop-blur" aria-label="<%= t("navigation.header") %>">
  <div class="mx-auto flex max-w-[100rem] items-center gap-3 px-page py-3 sm:gap-6">
    <%= link_to "/", class: "shrink-0 font-body text-lg font-bold tracking-[-0.03em] text-ink sm:text-xl", aria: { label: t("home.title") } do %>
      Bootcamper<span class="text-magenta">.dev</span>
    <% end %>
    <nav class="hidden min-w-0 flex-1 overflow-x-auto md:block" aria-label="<%= t("navigation.primary") %>">
      <ul class="flex min-w-max items-center justify-center gap-1.5">
        <% if signed_in %>
          <%= render partial: "layouts/navigation_item", collection: navigation_items, as: :item, locals: { horizontal: true } %>
        <% else %>
          <%= render partial: "layouts/navigation_item", collection: [["home", "/"], ["workshops", "/design/workshop-map"], ["how_it_works", "#how-it-works"]], as: :item, locals: { horizontal: true } %>
        <% end %>
      </ul>
    </nav>
    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <%= render "layouts/theme_selector" %>
    </div>
    <% if signed_in %>
      <%= render "layouts/profile_menu" %>
    <% else %>
      <div class="hidden items-center gap-2 sm:flex">
        <%= link_to t("navigation.public.join"), new_user_registration_path, class: "rounded-pill bg-magenta px-4 py-2 font-body text-sm font-semibold text-surface shadow-lifted transition-colors hover:bg-magenta/90" %>
      </div>
    <% end %>
  </div>
</header>

<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-surface-raised/95 px-2 pb-[env(safe-area-inset-bottom)] shadow-lifted backdrop-blur md:hidden" aria-label="<%= t("navigation.primary") %>">
  <ul class="mx-auto grid max-w-lg grid-cols-4 gap-1">
    <%= render partial: "layouts/navigation_item", collection: (signed_in ? navigation_items.first(4) : [["home", "/"], ["workshops", "/design/workshop-map"]]), as: :item, locals: { mobile: true } %>
    <% unless signed_in %><li><%= link_to t("navigation.public.join"), new_user_registration_path, class: "group flex min-h-14 flex-col items-center justify-center gap-0.5 rounded-control px-1 py-2 font-body text-[0.68rem] font-semibold text-ink-muted" %></li><% end %>
  </ul>
</nav>
