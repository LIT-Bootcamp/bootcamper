<% content_for :title, t("password_reset.request_title") %>

<section class="mx-auto max-w-xl px-4" aria-labelledby="password-reset-title">
  <div class="rounded-card border border-border bg-surface-raised p-6 shadow-lifted md:p-8">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-teal"><%= t("password_reset.eyebrow") %></p>
    <h1 id="password-reset-title" class="mt-2 font-display text-3xl font-bold text-ink"><%= t("password_reset.request_title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("password_reset.request_intro") %></p>

    <% if flash[:notice] || flash[:alert] %>
      <div class="mt-6 rounded-control border border-teal/40 bg-teal/10 p-4 text-sm text-ink" role="status">
        <%= flash[:notice] || flash[:alert] %>
      </div>
    <% end %>

    <%= form_with model: resource, scope: resource_name, url: password_reset_path, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :email, t("password_reset.email"), class: "font-body text-sm font-semibold text-ink" %>
        <%= form.email_field :email, autocomplete: "email", required: true, autofocus: true, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
      </div>

      <%= form.submit t("password_reset.request_submit"), class: "w-full rounded-pill bg-magenta px-4 py-3 font-body text-sm font-semibold text-surface shadow-lifted transition hover:bg-magenta/90" %>
    <% end %>
  </div>
</section>
