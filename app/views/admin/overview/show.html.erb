<% content_for :title, t("admin.title") %>

<section class="mx-auto max-w-4xl px-4" aria-labelledby="admin-overview-title">
  <div class="rounded-card border border-border bg-surface-raised p-6 shadow-lifted md:p-8">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-teal"><%= t("admin.eyebrow") %></p>
    <h1 id="admin-overview-title" class="mt-2 font-display text-3xl font-bold text-ink"><%= t("admin.title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("admin.intro") %></p>
    <div class="mt-8 rounded-card border border-dashed border-border p-6" role="status">
      <h2 class="font-display text-xl font-semibold text-ink"><%= t("admin.empty_title") %></h2>
      <p class="mt-2 font-body text-sm text-ink-muted"><%= t("admin.empty_message") %></p>
    </div>
  </div>
</section>
