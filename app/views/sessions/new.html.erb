<% content_for :title, t("sessions.title") %>

<section class="mx-auto max-w-xl px-4" aria-labelledby="session-title">
  <div class="rounded-card border border-border bg-surface-raised p-6 shadow-lifted md:p-8">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-teal"><%= t("sessions.eyebrow") %></p>
    <h1 id="session-title" class="mt-2 font-display text-3xl font-bold text-ink"><%= t("sessions.title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("sessions.intro") %></p>

    <% if flash[:alert] %>
      <div class="mt-6 rounded-control border border-danger/50 bg-danger/10 p-4 text-sm text-danger" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with model: resource, scope: resource_name, url: login_path, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :email, t("sessions.email"), class: "font-body text-sm font-semibold text-ink" %>
        <%= form.email_field :email, autocomplete: "email", required: true, autofocus: true, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
      </div>

      <div>
        <%= form.label :password, t("sessions.password"), class: "font-body text-sm font-semibold text-ink" %>
        <%= form.password_field :password, autocomplete: "current-password", required: true, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
      </div>

      <%= form.submit t("sessions.submit"), class: "w-full rounded-pill bg-magenta px-4 py-3 font-body text-sm font-semibold text-surface shadow-lifted transition hover:bg-magenta/90" %>
    <% end %>

    <p class="mt-5 text-center font-body text-sm text-ink-muted">
      <%= link_to t("sessions.register_prompt"), new_user_registration_path, class: "font-semibold text-teal hover:text-magenta" %>
    </p>
  </div>
</section>
