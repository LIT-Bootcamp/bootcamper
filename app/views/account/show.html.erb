<% content_for :title, t("account.title") %>

<section class="mx-auto max-w-3xl px-4" aria-labelledby="account-title">
  <div class="rounded-card border border-border bg-surface-raised p-6 shadow-lifted md:p-8">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-teal"><%= t("account.eyebrow") %></p>
    <h1 id="account-title" class="mt-2 font-display text-3xl font-bold text-ink"><%= t("account.title") %></h1>
    <p class="mt-3 font-body text-sm text-ink-muted"><%= t("account.intro", email: current_user.email) %></p>

    <% if flash[:notice] %>
      <p class="mt-5 rounded-control border border-teal/40 bg-teal/10 p-3 font-body text-sm text-ink" role="status"><%= flash[:notice] %></p>
    <% end %>

    <% if current_user.errors.any? %>
      <div class="mt-5 rounded-control border border-magenta/40 bg-magenta/10 p-3 font-body text-sm text-ink" role="alert">
        <p class="font-semibold"><%= t("account.errors") %></p>
        <ul class="mt-2 list-disc pl-5">
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-8 border-t border-border pt-6">
      <h2 class="font-display text-xl font-semibold text-ink"><%= t("account.profile_title") %></h2>
      <%= form_with model: current_user, url: account_path, method: :patch, html: { multipart: true, class: "mt-5 space-y-5" } do |form| %>
        <div>
          <%= form.label :display_name, t("account.display_name"), class: "block font-body text-sm font-semibold text-ink" %>
          <%= form.text_field :display_name, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink", autocomplete: "name" %>
        </div>
        <div>
          <%= form.label :avatar, t("account.avatar"), class: "block font-body text-sm font-semibold text-ink" %>
          <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "mt-2 block w-full font-body text-sm text-ink-muted" %>
        </div>
        <div>
          <%= form.label :technical_skills, t("account.technical_skills"), class: "block font-body text-sm font-semibold text-ink" %>
          <%= form.text_area :technical_skills, rows: 3, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
        </div>
        <div>
          <%= form.label :interests, t("account.interests"), class: "block font-body text-sm font-semibold text-ink" %>
          <%= form.text_area :interests, rows: 3, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
        </div>
        <div>
          <%= form.label :github_url, t("account.github_url"), class: "block font-body text-sm font-semibold text-ink" %>
          <%= form.url_field :github_url, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink", inputmode: "url" %>
        </div>
        <div>
          <%= form.label :profile_urls, t("account.profile_urls"), class: "block font-body text-sm font-semibold text-ink" %>
          <p class="mt-1 font-body text-xs text-ink-muted"><%= t("account.profile_urls_hint") %></p>
          <%= form.text_area :profile_urls, rows: 3, class: "mt-2 w-full rounded-control border border-border bg-surface px-3 py-2 text-ink" %>
        </div>
        <%= form.submit t("account.save_profile"), class: "rounded-pill bg-magenta px-5 py-3 font-body text-sm font-semibold text-surface shadow-lifted transition-colors hover:bg-magenta/90" %>
      <% end %>
    </div>
  </div>
</section>
